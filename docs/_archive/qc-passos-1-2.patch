@@ -0,0 +1,93 @@
+"""Admin dos catálogos de qualidade.
+
+Duas telas curtas e uma regra que vale repetir onde ela é editada: o desconto é
+do **grau**, o veto é do **defeito**, e os dois nunca se misturam. Defeito não
+tem percentual — se tivesse, cada palavra nova que o fournil inventasse viraria
+uma decisão de precificação.
+"""
+
+from __future__ import annotations
+
+from django.contrib import admin
+from django.utils.html import format_html
+from unfold.admin import ModelAdmin
+from unfold.decorators import display
+
+from shopman.shop.models import QualityDefect, QualityGrade
+
+
+@admin.register(QualityGrade)
+class QualityGradeAdmin(ModelAdmin):
+    list_display = ("label", "ref", "rank", "markdown_display", "destination", "is_default")
+    list_editable = ("rank", "is_default")
+    search_fields = ("ref", "label")
+    ordering = ("-rank",)
+    fieldsets = (
+        (None, {
+            "fields": ("label", "ref", "rank", "is_default"),
+            "description": (
+                "O <b>rótulo</b> é o que o padeiro lê e pode mudar quando quiser. "
+                "O <b>código</b> é gravado no lote e nunca muda. "
+                "A <b>posição</b> é a hierarquia: maior é melhor, e é ela que o "
+                "filtro de divulgação compara."
+            ),
+        }),
+        ("Consequência", {
+            "fields": ("markdown_percent",),
+            "description": (
+                "Resolvido uma vez, no fechamento da fornada, e congelado no lote. "
+                "Mudar aqui <b>não</b> reescreve lote já gravado — ontem continua "
+                "valendo o que valia ontem. Grau com desconto nunca vai para o dia "
+                "seguinte nem aparece nos canais remotos."
+            ),
+        }),
+    )
+
+    @display(description="preço")
+    def markdown_display(self, obj):
+        if not obj.markdown_percent:
+            return format_html('<span style="color:#0ca30c">cheio</span>')
+        return format_html(
+            '<b style="color:#ec835a">−{}%</b>', obj.markdown_percent
+        )
+
+    @display(description="dia seguinte")
+    def destination(self, obj):
+        return "vai" if obj.is_conforming else "não vai"
+
+
+@admin.register(QualityDefect)
+class QualityDefectAdmin(ModelAdmin):
+    list_display = ("label", "ref", "hint", "veto_display", "position", "is_active")
+    list_editable = ("position", "is_active")
+    list_filter = ("forces_discard", "is_active")
+    search_fields = ("ref", "label", "hint")
+    ordering = ("position",)
+    fieldsets = (
+        (None, {
+            "fields": ("label", "hint", "ref", "position", "is_active"),
+            "description": (
+                "O <b>sintoma</b> vira a segunda linha do botão no quiosque: é o "
+                "que faz a escolha ser reconhecimento em vez de diagnóstico. "
+                "Sem ele, quem não distinguir vai chutar — e chute vira ruído no "
+                "relatório, que é exatamente o que o controle de qualidade existe "
+                "para evitar."
+            ),
+        }),
+        ("Veto", {
+            "fields": ("forces_discard",),
+            "description": (
+                "Manda as unidades para perda, sem preço nenhum, e não há tela em "
+                "que o operador possa contrariar. "
+                "<b>Só para o que torna o alimento inseguro, nunca para o que o "
+                "torna feio.</b> Sujeira de forno e marcas vendem com desconto; "
+                "tentar limpar às vezes danifica o produto, e essa decisão é de "
+                "quem está com o pão na mão. Defeito não tem percentual: quem "
+                "define preço é sempre o grau."
+            ),
+        }),
+    )
+
+    @display(description="veto", boolean=True)
+    def veto_display(self, obj):
+        return obj.forces_discard
