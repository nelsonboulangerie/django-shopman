+"""
+Quality partition — a finished WorkOrder is a partition, not a scalar.
+
+A batch of 40 does not produce "38". It produces 32 at full price, 8 at a
+discount and 3 lost. ``finish()`` has always accepted a list; these tests cover
+the three opaque refs each group can now carry, and — most importantly — that
+this core never reads them.
+
+See docs/decisions/adr-017-quality-as-production-outcome.md
+"""
+
+from decimal import Decimal
+
+import pytest
+from shopman.craftsman import craft
+from shopman.craftsman.models import Recipe, WorkOrderItem
+
+
+@pytest.fixture
+def recipe(db):
+    return Recipe.objects.create(
+        ref="pao-forma-v1",
+        name="Pao de forma",
+        output_sku="pao-forma",
+        batch_size=Decimal("40"),
+    )
+
+
+def _outputs(wo):
+    return list(
+        wo.items.filter(kind=WorkOrderItem.Kind.OUTPUT).order_by("-quantity")
+    )
+
+
+def _wastes(wo):
+    return list(wo.items.filter(kind=WorkOrderItem.Kind.WASTE))
+
+
+class TestPartition:
+    def test_fornada_inteira_conforme_continua_um_grupo_so(self, recipe):
+        """O caminho escalar nao muda: quem passa um numero recebe uma linha."""
+        wo = craft.plan(recipe, 40)
+        craft.finish(wo, finished=40, expected_rev=0)
+
+        outputs = _outputs(wo)
+        assert len(outputs) == 1
+        assert outputs[0].quantity == Decimal("40.000")
+        assert outputs[0].quality_grade_ref == ""
+        assert outputs[0].batch_ref == ""
+
+    def test_particao_gera_uma_linha_por_grupo(self, recipe):
+        wo = craft.plan(recipe, 40)
+        craft.finish(
+            wo,
+            finished=[
+                {
+                    "item_ref": "pao-forma",
+                    "quantity": 32,
+                    "quality_grade_ref": "standard",
+                    "batch_ref": "pao-forma-20260807-1",
+                },
+                {
+                    "item_ref": "pao-forma",
+                    "quantity": 5,
+                    "quality_grade_ref": "minimal",
+                    "quality_defect_ref": "overbaked",
+                    "batch_ref": "pao-forma-20260807-1-B",
+                },
+            ],
+            wasted=[
+                {
+                    "item_ref": "pao-forma",
+                    "quantity": 3,
+                    "quality_defect_ref": "overbaked",
+                },
+            ],
+            expected_rev=0,
+        )
+
+        outputs = _outputs(wo)
+        assert len(outputs) == 2
+        assert [o.quality_grade_ref for o in outputs] == ["standard", "minimal"]
+        assert outputs[1].quality_defect_ref == "overbaked"
+        assert outputs[0].batch_ref != outputs[1].batch_ref
+
+        wastes = _wastes(wo)
+        assert len(wastes) == 1
+        assert wastes[0].quality_defect_ref == "overbaked"
+        assert wastes[0].quality_grade_ref == ""
+
+    def test_previsto_fecha_com_a_soma_dos_grupos(self, recipe):
+        """previsto = soma(OUTPUT) + soma(WASTE). Grupos disjuntos."""
+        wo = craft.plan(recipe, 40)
+        craft.finish(
+            wo,
+            finished=[
+                {"item_ref": "pao-forma", "quantity": 32, "quality_grade_ref": "standard"},
+                {"item_ref": "pao-forma", "quantity": 5, "quality_grade_ref": "minimal"},
+            ],
+            wasted=[{"item_ref": "pao-forma", "quantity": 3}],
+            expected_rev=0,
+        )
+        wo.refresh_from_db()
+
+        produced = sum(o.quantity for o in _outputs(wo))
+        lost = sum(w.quantity for w in _wastes(wo))
+        assert produced + lost == wo.quantity
+        assert wo.finished == produced
+
+    def test_grupo_sem_qualidade_e_valido(self, recipe):
+        """Particao sem QC nenhum: quem so quer dois lotes nao paga por qualidade."""
+        wo = craft.plan(recipe, 40)
+        craft.finish(
+            wo,
+            finished=[
+                {"item_ref": "pao-forma", "quantity": 20, "batch_ref": "lote-a"},
+                {"item_ref": "pao-forma", "quantity": 20, "batch_ref": "lote-b"},
+            ],
+            expected_rev=0,
+        )
+        assert all(o.quality_grade_ref == "" for o in _outputs(wo))
+
+
+class TestCoreNeverInterprets:
+    """O core registra a classificacao e nunca a le. Isto e o contrato."""
+
+    def test_qualquer_string_passa(self, recipe):
+        """Nao ha choices, nao ha validacao de vocabulario: outra instancia,
+        outra escala."""
+        wo = craft.plan(recipe, 40)
+        craft.finish(
+            wo,
+            finished=[
+                {"item_ref": "pao-forma", "quantity": 40, "quality_grade_ref": "roast_city"},
+            ],
+            expected_rev=0,
+        )
+        assert _outputs(wo)[0].quality_grade_ref == "roast_city"
+
+    def test_grau_nao_altera_quantidade_nem_status(self, recipe):
+        """Grau nao vira desconto, nao vira perda, nao vira nada aqui."""
+        wo = craft.plan(recipe, 40)
+        craft.finish(
+            wo,
+            finished=[
+                {"item_ref": "pao-forma", "quantity": 40, "quality_grade_ref": "minimal",
+                 "quality_defect_ref": "contaminated"},
+            ],
+            expected_rev=0,
+        )
+        wo.refresh_from_db()
+
+        assert wo.finished == Decimal("40.000")
+        assert _wastes(wo) == []
+        assert wo.status == "finished"
+
+    def test_ordem_dos_grupos_nao_implica_hierarquia(self, recipe):
+        """O core nao sabe qual grau e melhor — grava na ordem em que recebeu."""
+        wo = craft.plan(recipe, 40)
+        craft.finish(
+            wo,
+            finished=[
+                {"item_ref": "pao-forma", "quantity": 8, "quality_grade_ref": "minimal"},
+                {"item_ref": "pao-forma", "quantity": 32, "quality_grade_ref": "excellent"},
+            ],
+            expected_rev=0,
+        )
+        by_pk = list(wo.items.filter(kind=WorkOrderItem.Kind.OUTPUT).order_by("pk"))
+        assert [o.quality_grade_ref for o in by_pk] == ["minimal", "excellent"]
+
+    def test_ref_longa_e_truncada_nao_rejeitada(self, recipe):
+        """Classificacao alheia nao derruba producao: trunca e segue."""
+        wo = craft.plan(recipe, 40)
+        craft.finish(
+            wo,
+            finished=[
+                {"item_ref": "pao-forma", "quantity": 40, "quality_grade_ref": "x" * 90},
+            ],
+            expected_rev=0,
+        )
+        assert len(_outputs(wo)[0].quality_grade_ref) == 32
+
+
+class TestLedgerQueries:
+    """O relatorio que nao existe ainda tem que ser reconstruivel daqui."""
+
+    def test_agrega_por_defeito(self, recipe):
+        for i, defect in enumerate(["overbaked", "overbaked", "underproofed"]):
+            wo = craft.plan(recipe, 40, target_date=None)
+            craft.finish(
+                wo,
+                finished=[
+                    {"item_ref": "pao-forma", "quantity": 36, "quality_grade_ref": "standard"},
+                    {"item_ref": "pao-forma", "quantity": 4, "quality_grade_ref": "fair",
+                     "quality_defect_ref": defect},
+                ],
+                expected_rev=0,
+                idempotency_key=f"seed-{i}",
+            )
+
+        from django.db.models import Sum
+
+        rows = dict(
+            WorkOrderItem.objects.filter(kind=WorkOrderItem.Kind.OUTPUT)
+            .exclude(quality_defect_ref="")
+            .values_list("quality_defect_ref")
+            .annotate(total=Sum("quantity"))
+        )
+        assert rows == {"overbaked": Decimal("8.000"), "underproofed": Decimal("4.000")}
