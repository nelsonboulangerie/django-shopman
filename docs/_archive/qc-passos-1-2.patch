new file mode 100644
index 00000000..f2a3d18f
--- /dev/null
+++ b/shopman/shop/models/quality.py
@@ -0,0 +1,142 @@
+"""Catálogos de qualidade da fornada — a política que o core não conhece.
+
+O ``craftsman`` grava ``quality_grade_ref`` e ``quality_defect_ref`` como strings
+opacas: ele não sabe qual grau é melhor, quanto vale, nem que um defeito pode
+vetar a venda. Isso é política de instância, e é aqui que ela mora — editável no
+Admin, sem tocar em código.
+
+Dois eixos, deliberadamente separados:
+
+- ``QualityGrade``  — **quanto** desviou. É o único eixo de preço.
+- ``QualityDefect`` — **por que** desviou. Diagnóstico, nunca preço.
+
+Acrescentar um defeito novo jamais exige uma decisão de precificação. Foi a
+razão de existir dessa separação: "queimado" não é binário, tem grau — e o grau
+é que decide o desconto.
+
+Ver docs/decisions/adr-017-quality-as-production-outcome.md
+"""
+
+from __future__ import annotations
+
+from django.core.exceptions import ValidationError
+from django.db import models
+from simple_history.models import HistoricalRecords
+
+#: Grau assumido quando a fornada não informa nada.
+FALLBACK_GRADE_REF = "standard"
+
+
+class QualityGrade(models.Model):
+    """Uma faixa da escala de qualidade da fornada.
+
+    Substitui a tupla literal que existia duplicada entre o broadcast e a
+    produção: a hierarquia agora é ``rank``, e existe num lugar só.
+    """
+
+    ref = models.CharField(
+        "código", max_length=32, unique=True,
+        help_text="Valor gravado no lote e na ordem. Nunca muda: excellent, standard…",
+    )
+    label = models.CharField(
+        "rótulo", max_length=60,
+        help_text="O que o padeiro lê no botão. Pode mudar quando quiser.",
+    )
+    rank = models.IntegerField(
+        "posição", unique=True,
+        help_text="Maior = melhor. É a hierarquia que o filtro de broadcast compara.",
+    )
+    markdown_percent = models.PositiveSmallIntegerField(
+        "desconto (%)", default=0,
+        help_text=(
+            "Resolvido uma vez, no fechamento da fornada, e congelado no lote. "
+            "Mudar aqui não reescreve lote já gravado."
+        ),
+    )
+    is_default = models.BooleanField(
+        "padrão", default=False,
+        help_text="O grau já selecionado no quiosque. Só um pode ser.",
+    )
+
+    history = HistoricalRecords()
+
+    class Meta:
+        ordering = ["-rank"]
+        verbose_name = "grau de qualidade"
+        verbose_name_plural = "graus de qualidade"
+        constraints = [
+            models.UniqueConstraint(
+                fields=["is_default"],
+                condition=models.Q(is_default=True),
+                name="shop_quality_grade_single_default",
+            ),
+            models.CheckConstraint(
+                condition=models.Q(markdown_percent__lte=100),
+                name="shop_quality_grade_percent_range",
+            ),
+        ]
+
+    def __str__(self) -> str:
+        if self.markdown_percent:
+            return f"{self.label} (−{self.markdown_percent}%)"
+        return self.label
+
+    @property
+    def is_conforming(self) -> bool:
+        """Sem desconto é fornada conforme — vai para o dia seguinte."""
+        return self.markdown_percent == 0
+
+
+class QualityDefect(models.Model):
+    """Um tipo nomeado de falha.
+
+    Não é "um motivo": motivo é a pergunta que o lote faz. O defeito é a
+    resposta, e por isso tem catálogo, ordem e veto próprio.
+    """
+
+    ref = models.CharField(
+        "código", max_length=32, unique=True,
+        help_text="Valor gravado na ordem. Nunca muda: overbaked, underproofed…",
+    )
+    label = models.CharField(
+        "rótulo", max_length=60,
+        help_text="O que o padeiro lê no botão.",
+    )
+    hint = models.CharField(
+        "sintoma", max_length=80, blank=True,
+        help_text=(
+            "Segunda linha do botão, com o que se vê: “pequeno, denso, rasgou”. "
+            "É o que torna a escolha reconhecimento em vez de diagnóstico."
+        ),
+    )
+    forces_discard = models.BooleanField(
+        "força descarte", default=False,
+        help_text=(
+            "Manda as unidades para perda, sem preço nenhum. "
+            "Só para o que torna o alimento inseguro — nunca para o que o torna feio."
+        ),
+    )
+    position = models.IntegerField(
+        "ordem", default=0,
+        help_text="Ordem no quiosque. Menor aparece primeiro.",
+    )
+    is_active = models.BooleanField("ativo", default=True)
+
+    history = HistoricalRecords()
+
+    class Meta:
+        ordering = ["position", "label"]
+        verbose_name = "defeito"
+        verbose_name_plural = "defeitos"
+
+    def __str__(self) -> str:
+        return f"{self.label} (descarte)" if self.forces_discard else self.label
+
+    def clean(self):
+        if self.forces_discard and not self.is_active:
+            raise ValidationError({
+                "is_active": (
+                    "Defeito que força descarte não pode ser desativado: "
+                    "desative o veto primeiro, conscientemente."
+                ),
+            })
