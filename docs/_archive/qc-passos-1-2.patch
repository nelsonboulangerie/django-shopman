+"""Seed dos catálogos de qualidade.
+
+Quatro graus e sete defeitos. Os rótulos são editáveis no Admin; os códigos são
+para sempre. Ver docs/plans/QC-FORNADA.md §2 e §3 para o raciocínio de cada nome
+— em especial por que "Aceitável" não nomeia o degrau do meio e por que "sujo"
+não é veto.
+"""
+
+from django.db import migrations
+
+GRADES = [
+    # ref,          label,       rank, percent, default
+    ("excellent", "Ótima", 40, 0, False),
+    ("standard", "Normal", 30, 0, True),
+    ("fair", "Razoável", 20, 20, False),
+    ("minimal", "Mínima", 10, 50, False),
+]
+
+DEFECTS = [
+    # ref,           label,               hint,                     veto,  pos
+    ("underproofed", "Fermentou pouco", "pequeno, denso, rasgou", False, 10),
+    ("overproofed", "Fermentou demais", "murchou, achatou", False, 20),
+    ("underbaked", "Assou pouco", "pálido, cru", False, 30),
+    ("overbaked", "Assou demais", "escuro, queimado", False, 40),
+    ("misshapen", "Deformado", "torto, colado, fora de tamanho", False, 50),
+    ("scorch_marks", "Marcas de forno", "fuligem, manchas", False, 60),
+    ("contaminated", "Contaminado", "matéria estranha", True, 70),
+]
+
+
+def seed(apps, schema_editor):
+    QualityGrade = apps.get_model("shop", "QualityGrade")
+    QualityDefect = apps.get_model("shop", "QualityDefect")
+
+    for ref, label, rank, percent, is_default in GRADES:
+        QualityGrade.objects.update_or_create(
+            ref=ref,
+            defaults={
+                "label": label,
+                "rank": rank,
+                "markdown_percent": percent,
+                "is_default": is_default,
+            },
+        )
+
+    for ref, label, hint, veto, position in DEFECTS:
+        QualityDefect.objects.update_or_create(
+            ref=ref,
+            defaults={
+                "label": label,
+                "hint": hint,
+                "forces_discard": veto,
+                "position": position,
+                "is_active": True,
+            },
+        )
+
+
+def unseed(apps, schema_editor):
+    apps.get_model("shop", "QualityGrade").objects.filter(
+        ref__in=[g[0] for g in GRADES]
+    ).delete()
+    apps.get_model("shop", "QualityDefect").objects.filter(
+        ref__in=[d[0] for d in DEFECTS]
+    ).delete()
+
+
+class Migration(migrations.Migration):
+    dependencies = [("shop", "0034_quality_catalogs")]
+    operations = [migrations.RunPython(seed, unseed)]
