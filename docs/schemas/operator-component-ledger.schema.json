{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "operator-component-ledger.schema.json",
  "title": "Shopman operator component ledger",
  "type": "object",
  "required": ["version", "scope", "audit", "families", "apps"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "scope": { "type": "object" },
    "audit": {
      "type": "object",
      "required": ["owner", "browser_lock", "runner", "evidence_root", "closure_gate", "viewports", "states"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "browser_lock": { "type": "string", "minLength": 1 },
        "runner": { "type": "string", "minLength": 1 },
        "evidence_root": { "type": "string", "minLength": 1 },
        "closure_gate": { "type": "string", "minLength": 1 },
        "viewports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label", "width", "height", "profile", "touch"]
          }
        },
        "states": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "apps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "owner", "directory", "profiles", "baseline", "surfaces"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "directory": { "type": "string", "pattern": "-nuxt$" },
          "profiles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "baseline": {
            "type": "object",
            "required": ["local_ui_files", "direct_reka_import_files", "manual_overlay_files", "native_control_occurrences"],
            "additionalProperties": false,
            "properties": {
              "local_ui_files": { "type": "integer", "minimum": 0 },
              "direct_reka_import_files": { "type": "integer", "minimum": 0 },
              "manual_overlay_files": { "type": "integer", "minimum": 0 },
              "native_control_occurrences": { "type": "integer", "minimum": 0 }
            }
          },
          "surfaces": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "source_files", "routes", "variants", "families", "status"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "source_files": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string" }
                },
                "routes": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string" }
                },
                "variants": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string" }
                },
                "families": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string" }
                },
                "status": { "type": "string" },
                "states": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string" }
                },
                "viewports": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string" }
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["route", "scenario", "state", "viewport", "capture", "visited"],
                    "properties": {
                      "route": { "type": "string" },
                      "scenario": { "type": "string" },
                      "state": { "type": "string" },
                      "viewport": { "type": "string" },
                      "capture": { "type": "string" },
                      "visited": { "const": true }
                    }
                  }
                },
                "exceptions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["kind", "app", "surface", "use_case", "canonical_limitation", "rejected_alternatives", "justification", "owner", "test"],
                    "properties": {
                      "kind": { "type": "string", "minLength": 1 },
                      "app": { "type": "string", "minLength": 1 },
                      "surface": { "type": "string", "minLength": 1 },
                      "use_case": { "type": "string", "minLength": 1 },
                      "canonical_limitation": { "type": "string", "minLength": 1 },
                      "rejected_alternatives": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                      "justification": { "type": "string", "minLength": 1 },
                      "owner": { "type": "string", "minLength": 1 },
                      "test": { "type": "string", "minLength": 1 }
                    }
                  }
                },
                "reason": { "type": "string" },
                "owner": { "type": "string" },
                "tests": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
