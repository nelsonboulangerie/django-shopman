{
  "name": "@shopman/operator-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nuxt layer compartilhado das oito superfícies de operador: BFF, resiliência de rede, telemetria, design system canônico e guardrails de consistência.",
  "scripts": {
    "catalog:dev": "OPERATOR_KIT_CATALOG=1 nuxt dev --host 127.0.0.1 --port 33113",
    "catalog:build": "OPERATOR_KIT_CATALOG=1 nuxt build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "typecheck": "OPERATOR_KIT_CATALOG=1 nuxt prepare && OPERATOR_KIT_CATALOG=1 vue-tsc --build tsconfig.operator-kit.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify/collections": "^1.0.761",
    "@nuxt/test-utils": "^4.3.4",
    "@playwright/test": "^1.65.0",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/core": "^14.4.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "nuxt": "4.6.3",
    "reka-ui": "^2.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12",
    "vue": "^3.5.45",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/line-md": "^1.2.16",
    "@iconify-json/lucide": "1.2.151",
    "@iconify-json/tabler": "1.2.43",
    "@internationalized/date": "3.12.4",
    "@nuxt/kit": "4.6.2",
    "@nuxt/ui": "^4.11.3",
    "@unovis/ts": "^1.7.1",
    "@unovis/vue": "^1.7.1",
    "@vite-pwa/nuxt": "1.1.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "vue-sonner": "^2.0.9"
  },
  "overrides": {
    "@nuxt/schema": "4.6.2",
    "esbuild": "^0.28.1",
    "svgo": "^4.1.0",
    "glob": "^14.0.3",
    "minimatch": "^11.0.4",
    "@eslint/config-array": {
      "minimatch": "^11.0.4"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.4"
    },
    "eslint": {
      "minimatch": "^11.0.4"
    }
  }
}
