{
  "name": "@shopman/operator-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nuxt layer compartilhado das oito superfícies de operador: BFF, resiliência de rede, telemetria, design system canônico e guardrails de consistência.",
  "scripts": {
    "catalog:dev": "OPERATOR_KIT_CATALOG=1 nuxt dev --host 127.0.0.1 --port 33113",
    "catalog:build": "OPERATOR_KIT_CATALOG=1 nuxt build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "typecheck": "OPERATOR_KIT_CATALOG=1 nuxt typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify/collections": "^1.0.744",
    "@nuxt/test-utils": "^4.3.2",
    "@playwright/test": "^1.63.0",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/core": "^14.4.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "nuxt": "^4.5.2",
    "reka-ui": "^2.10.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11",
    "vue": "^3.5.43",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.12"
  },
  "dependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/line-md": "^1.2.16",
    "@iconify-json/lucide": "1.2.137",
    "@iconify-json/tabler": "1.2.40",
    "@internationalized/date": "3.12.4",
    "@nuxt/kit": "3.21.11",
    "@nuxt/ui": "^4.11.3",
    "@vite-pwa/nuxt": "1.1.1",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "vue-sonner": "^2.0.9"
  },
  "overrides": {
    "svgo": "^4.1.0"
  }
}
