{
  "name": "storefront-nuxt",
  "type": "module",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --host 127.0.0.1 --port 3000",
    "generate": "nuxt generate",
    "preview": "nuxt preview --host 127.0.0.1 --port 3000",
    "pwa:assets": "node scripts/prepare-pwa-assets.mjs && pwa-assets-generator --config pwa-assets.config.ts && node scripts/finalize-pwa-assets.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:e2e": "playwright test",
    "test:ux": "node scripts/ux-smoke.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxi typecheck",
    "format": "prettier --write .",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@internationalized/number": "^3.6.8",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.5.1",
    "@nuxtjs/color-mode": "^4.0.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@vite-pwa/nuxt": "1.1.1",
    "@vueuse/nuxt": "^14.4.0",
    "motion-v": "^2.4.2",
    "nostics": "^1.2.0",
    "nuxt": "^4.5.2",
    "qrcode": "^1.5.4",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.131",
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/test-utils": "^4.0.3",
    "@playwright/test": "^1.63.0",
    "@types/google.maps": "^3.66.2",
    "@vite-pwa/assets-generator": "1.0.4",
    "@vue/test-utils": "^2.5.0",
    "@yuta-inoue-ph/nuxt-vcalendar": "^1.1.4",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.6",
    "sharp": "0.35.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "js-yaml": "^4.3.2",
    "svgo": "^4.1.0"
  }
}
