# syntax=docker/dockerfile:1
# Imagem genérica das superfícies Nuxt — uma receita, nove apps (ARG SURFACE).
# Buildada no GitHub Actions (deploy-images.yml) e publicada no DOCR; o App
# Platform só faz pull + rollout, fora da fila de builders da DO. NUXT_PUBLIC_*
# é runtimeConfig: continua vindo do spec em RUN_TIME, a imagem é agnóstica de
# ambiente.

FROM node:22-alpine AS build
ARG SURFACE
WORKDIR /repo
# A operator-kit é a layer compartilhada (extends: ../operator-kit) — precisa
# estar na árvore para qualquer app de operador buildar. O storefront não a
# usa, mas copiá-la é inofensivo e mantém a receita única.
COPY surfaces/operator-kit ./surfaces/operator-kit
COPY surfaces/${SURFACE} ./surfaces/${SURFACE}
WORKDIR /repo/surfaces/${SURFACE}
RUN npm ci && npm run build

FROM node:22-alpine
ARG SURFACE
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3000
WORKDIR /app
COPY --from=build /repo/surfaces/${SURFACE}/.output ./.output
EXPOSE 3000
CMD ["node", ".output/server/index.mjs"]
