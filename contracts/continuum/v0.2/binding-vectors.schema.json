{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.test/continuum/v0.2/binding-vectors.schema.json",
  "title": "Continuum 0.2 binding, producer, and isolation vectors",
  "type": "object",
  "required": ["protocol_version", "semantics", "vectors"],
  "properties": {
    "protocol_version": {"const": "0.2"},
    "semantics": {"type": "string", "minLength": 1},
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/vector"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "layer": {
      "enum": [
        "authorization",
        "http",
        "cache",
        "sse",
        "parser",
        "producer",
        "multistream",
        "command",
        "rollout"
      ]
    },
    "capability": {
      "enum": [
        "continuum.snapshot.v0.2",
        "continuum.invalidate.v0.2",
        "continuum.patch.json.v0.2",
        "continuum.patch.merge.v0.2",
        "continuum.replay.v0.2",
        "continuum.command-receipt.v0.2"
      ]
    },
    "deploymentProfile": {
      "enum": [
        "protected-data",
        "cookie-auth",
        "non-cookie-auth",
        "public-data",
        "public-shared-cache",
        "native-eventsource",
        "fetch-stream",
        "service-worker-present",
        "ssr-bootstrap",
        "prehydration-purge-guard",
        "multiplexed-stream",
        "snapshot-first",
        "subscribe-first",
        "rollout-candidate",
        "external-provider"
      ]
    },
    "limitName": {
      "enum": [
        "max_compressed_response_bytes",
        "max_decoded_response_bytes",
        "max_response_head_bytes",
        "max_request_head_bytes",
        "max_request_body_bytes",
        "max_request_identifier_bytes",
        "max_sse_line_bytes",
        "max_sse_event_data_bytes",
        "max_json_nodes",
        "max_json_depth",
        "max_patch_ops",
        "max_result_bytes",
        "max_resident_bytes",
        "max_decompression_ratio_milli",
        "max_decompression_ms",
        "max_queue_events",
        "max_queue_bytes",
        "max_dedupe_entries",
        "max_events_per_subscription_generation",
        "max_bytes_per_subscription_generation",
        "max_subscription_generation_ms",
        "max_streams_per_connection",
        "max_connections_per_principal",
        "max_connections_per_tenant",
        "max_connections_per_ip",
        "max_events_per_second",
        "max_reconnects_per_minute",
        "max_backoff_ms",
        "max_repair_attempts",
        "max_retry_ms",
        "max_canonical_reconcile_interval_ms",
        "max_canonical_reconcile_jitter_ms",
        "max_replay_events",
        "max_replay_bytes",
        "max_replay_ms",
        "max_pending_commands",
        "max_command_operations_per_minute",
        "max_command_retry_ms",
        "max_accepted_terminal_ms",
        "max_receipt_retention_ms",
        "max_lease_ms",
        "max_revocation_sla_ms",
        "max_active_subscription_lineages_per_context",
        "max_lease_operations_per_minute"
      ]
    },
    "limitRef": {
      "type": "object",
      "required": ["$limit_ref"],
      "properties": {
        "$limit_ref": {"$ref": "#/$defs/limitName"},
        "delta": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991}
      },
      "additionalProperties": false
    },
    "nonNegativeIntegerOrLimitRef": {
      "oneOf": [
        {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        {"$ref": "#/$defs/limitRef"}
      ]
    },
    "boundaryProbe": {
      "type": "object",
      "required": ["limit", "target"],
      "properties": {
        "limit": {"$ref": "#/$defs/limitName"},
        "target": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "replacement": {
      "type": "object",
      "required": ["path", "value"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?:|(?:/(?:[^~/]|~[01])*)*)$"
        },
        "value": {}
      },
      "additionalProperties": false
    },
    "headers": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z0-9-]+$"},
      "additionalProperties": {
        "oneOf": [
          {"type": "string"},
          {"type": "integer"},
          {"type": "boolean"},
          {"type": "array", "items": {"type": "string"}},
          {"$ref": "#/$defs/limitRef"}
        ]
      }
    },
    "action": {
      "type": "object",
      "required": ["op", "target"],
      "properties": {
        "op": {
          "enum": [
            "configure",
            "request",
            "respond",
            "authorize",
            "mutate",
            "commit",
            "crash",
            "restart",
            "connect",
            "disconnect",
            "replay",
            "deliver",
            "advance",
            "overflow",
            "parse",
            "cache_lookup",
            "cache_store",
            "service_worker",
            "kill_switch",
            "concurrent_write",
            "rebuild"
          ]
        },
        "target": {"type": "string", "minLength": 1},
        "request_uri": {
          "type": "string",
          "pattern": "^/(?:[^\\s#]*)$",
          "maxLength": 2048
        },
        "csrf_negative_probe": {"type": "boolean"},
        "actor": {"type": "string"},
        "concurrency_group": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,127}$"},
        "principal": {"type": "string"},
        "tenant": {"type": "string"},
        "stream_id": {"type": "string"},
        "fixture": {"type": "string"},
        "fixtures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {
                "type": "object",
                "required": ["fixture", "replace"],
                "properties": {
                  "fixture": {"type": "string", "minLength": 1},
                  "replace": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"$ref": "#/$defs/replacement"}
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "expected_batch_violation": {
          "enum": [
            "stream_mismatch",
            "schema_mismatch",
            "epoch_mismatch",
            "noncontiguous_chain",
            "final_version_header_mismatch",
            "final_freshness_header_mismatch",
            "invalid_age_header"
          ]
        },
        "authoritative_validation_cut": {"type": "boolean"},
        "correlates_request_target": {"type": "string", "minLength": 1},
        "wire_body_encoding": {"const": "jcs-utf8"},
        "local_elapsed_ms": {"$ref": "#/$defs/nonNegativeIntegerOrLimitRef"},
        "expected_effective_age_ms": {"$ref": "#/$defs/nonNegativeIntegerOrLimitRef"},
        "replace": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/replacement"}
        },
        "headers": {"$ref": "#/$defs/headers"},
        "body": {},
        "body_octets_utf8": {
          "type": "string",
          "description": "Exact UTF-8 request body octets for parser-negative probes that cannot themselves be represented as an I-JSON value in this corpus. Mutually exclusive with body."
        },
        "status": {"type": "integer", "minimum": 100, "maximum": 599},
        "retry_after_ms": {"$ref": "#/$defs/nonNegativeIntegerOrLimitRef"},
        "lease_age_ms": {"$ref": "#/$defs/nonNegativeIntegerOrLimitRef"},
        "lease_for_ms": {"$ref": "#/$defs/nonNegativeIntegerOrLimitRef"},
        "count": {"$ref": "#/$defs/nonNegativeIntegerOrLimitRef"},
        "size_bytes": {"$ref": "#/$defs/nonNegativeIntegerOrLimitRef"},
        "depth": {"$ref": "#/$defs/nonNegativeIntegerOrLimitRef"},
        "milliseconds": {"$ref": "#/$defs/nonNegativeIntegerOrLimitRef"},
        "note": {"type": "string"}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "required": ["fixture", "fixtures"]
          }
        },
        {
          "not": {
            "required": ["fixtures", "replace"]
          }
        },
        {
          "not": {
            "required": ["body", "body_octets_utf8"]
          }
        },
        {
          "if": {"required": ["fixture"]},
          "then": {
            "not": {
              "anyOf": [
                {"required": ["lease_for_ms"]},
                {"required": ["lease_age_ms"]}
              ]
            }
          }
        },
        {
          "if": {
            "properties": {"op": {"const": "concurrent_write"}},
            "required": ["op"]
          },
          "then": {"required": ["actor", "concurrency_group"]}
        }
      ]
    },
    "assertion": {
      "type": "object",
      "required": ["path", "op"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?:/(?:[^~/]|~[01])*)*$"},
        "op": {
          "enum": [
            "eq",
            "ne",
            "lt",
            "absent",
            "present",
            "lte",
            "gte",
            "contains",
            "contains_token",
            "not_contains",
            "unchanged",
            "absent_or_lte",
            "one_of"
          ]
        },
        "value": {},
        "note": {"type": "string"}
      },
      "additionalProperties": false
    },
    "vector": {
      "type": "object",
      "required": [
        "id",
        "description",
        "layer",
        "capabilities",
        "given",
        "actions",
        "assertions"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,127}$"},
        "description": {"type": "string", "minLength": 1},
        "layer": {"$ref": "#/$defs/layer"},
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/capability"}
        },
        "requires_profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/deploymentProfile"}
        },
        "excludes_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/capability"}
        },
        "excludes_profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/deploymentProfile"}
        },
        "excludes_layers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/layer"}
        },
        "requires_limits": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/limitName"}
        },
        "boundary_probes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/boundaryProbe"}
        },
        "given": {"type": "object", "additionalProperties": true},
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/action"}
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/assertion"}
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"required": ["requires_limits"]},
          "then": {"required": ["boundary_probes"]}
        }
      ]
    }
  }
}
