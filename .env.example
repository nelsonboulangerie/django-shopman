# ── Django ────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
SHOPMAN_ENVIRONMENT=development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://127.0.0.1:3000
PORT=8000

# ── Domínios / cookie cross-subdomínio (staging/prod) ─────────────────
# Apex da loja e zona de cookie compartilhada entre as surfaces de operador
# (admin./pdv./kds./gestor./prod.). Em prod, defina ambos para a zona real
# (ex.: boulangerie.com.br) para o login único cross-subdomínio funcionar.
# SHOPMAN_DOMAIN=boulangerie.com.br
# SHOPMAN_OPERATOR_COOKIE_DOMAIN=.boulangerie.com.br
# AUTH_DEFAULT_DOMAIN=boulangerie.com.br
# SHOPMAN_PURCHASE_BASE_URL=https://compras.boulangerie.com.br

# ── Bootstrap do superuser nominal (matar admin/admin) ────────────────
# Consumidos por: python manage.py bootstrap_admin --deactivate-seed-admin
# Senha rejeitada fora de DEBUG se < 12 chars ou trivial. Defina antes de
# qualquer ambiente público.
# SHOPMAN_ADMIN_USERNAME=
# SHOPMAN_ADMIN_EMAIL=
# SHOPMAN_ADMIN_PASSWORD=
# 2FA do Admin: vire true após enrollar operadores (setup_admin_totp).
# SHOPMAN_ADMIN_REQUIRE_2FA=false

# ── Extensões opcionais ───────────────────────────────────────────────
# Apps extras pip-instaláveis (entram em INSTALLED_APPS). A loja é
# config + dados + marca: o `seed` vive no app `config`, sem pacote de tenant.
# Estratégia de cliente de balcão é built-in; o hook abaixo é para custom.
SHOPMAN_INSTANCE_APPS=
SHOPMAN_CUSTOMER_STRATEGY_MODULES=
# Optional idempotent contact bootstrap for:
# python manage.py configure_shop_contact
# SHOPMAN_SHOP_NAME=Nelson Boulangerie
# SHOPMAN_SHOP_PHONE=554333231997
# SHOPMAN_SHOP_EMAIL=nelson@boulangerie.com.br
# SHOPMAN_SHOP_WHATSAPP=https://wa.me/554333231997

# ── Release readiness evidence ───────────────────────────────────────
# SHOPMAN_PREPROD_URL=https://staging.example.com
# SHOPMAN_MANUAL_QA_EVIDENCE=/app/reports/manual-qa.md

# ── Database ──────────────────────────────────────────────────────────
# Postgres é o default de dev — casa com docker-compose (make up).
# Deixe comentado para cair no fallback SQLite (útil para CI leve / scripts).
DATABASE_URL=postgres://shopman:shopman@localhost:5432/shopman
POSTGRES_DB=shopman
POSTGRES_USER=shopman
POSTGRES_PASSWORD=shopman
# Staging/prod pequenos podem precisar fechar conexões por request para não
# esgotar o limite do PostgreSQL gerenciado. Default do código: 60.
# DATABASE_CONN_MAX_AGE=0

# ── Redis ─────────────────────────────────────────────────────────────
# Cache compartilhado para django-ratelimit + caches operacionais + SSE multi-worker.
# Obrigatório em staging/prod. Comente só para fallback local leve.
REDIS_URL=redis://localhost:6379/0

# ── Static/media ──────────────────────────────────────────────────────
# Docker/release usa STATIC_ROOT para collectstatic. Reverse proxy/CDN deve
# servir esse diretório em staging/prod; Django não é o servidor de estáticos.
# STATIC_ROOT=/app/staticfiles

# ── Shopman adapters (payment) ────────────────────────────────────────
# Per-method PIX / card adapter. Defaults to the in-process mock backend;
# override per environment. When left on payment_mock, the mock PIX flow
# schedules a mock_pix.confirm directive that runs the same confirm_pix
# service as the real EFI webhook — dev parity is enforced by code path.
# SHOPMAN_PIX_ADAPTER=shopman.shop.adapters.payment_efi
# SHOPMAN_CARD_ADAPTER=shopman.shop.adapters.payment_stripe
# Link de pagamento do balcão (pedido remoto, o cliente paga do celular). Sem a
# env: simulador em DEBUG, o adapter do cartão fora dele. Trocar de provedor é
# trocar ESTA env e nada mais — a prontidão do link (tecla L do PDV, painel de
# integrações) segue o adapter configurado. O link captura sozinho
# (capture_method=automatic); STRIPE_CAPTURE_METHOD vale só para o cartão da loja.
# SHOPMAN_LINK_ADAPTER=shopman.shop.adapters.payment_stripe
#
# Alpha técnico com Pix/card mockados:
# SHOPMAN_ENVIRONMENT=staging
# SHOPMAN_ALLOW_MOCK_PAYMENT_ADAPTERS=true
# SHOPMAN_EXPOSE_MOCK_CAPTURE=true   # botão "Simular pagamento"; nunca em produção
# SHOPMAN_MOCK_PIX_AUTO_CONFIRM=true # alternativa/apoio ao botão em rodada acompanhada
#
# Staging/POS real gateway profile:
# SHOPMAN_ENVIRONMENT=staging
# SHOPMAN_PIX_ADAPTER=shopman.shop.adapters.payment_efi
# SHOPMAN_CARD_ADAPTER=shopman.shop.adapters.payment_stripe
# SHOPMAN_LINK_ADAPTER=shopman.shop.adapters.payment_stripe
# SHOPMAN_FISCAL_ADAPTER=shopman.shop.adapters.fiscal_focusnfe.FocusNFeBackend

# PIX intent expiry (in seconds).
# SHOPMAN_PIX_EXPIRY_SECONDS=3600

# ── EFI (real PIX backend) ────────────────────────────────────────────
# EFI_SANDBOX=true            # false em produção
# EFI_CLIENT_ID=
# EFI_CLIENT_SECRET=
# EFI_PIX_KEY=
# EFI_WEBHOOK_TOKEN=          # Shared secret with EFI dashboard (required)
# EFI_MTLS_HEADER=HTTP_X_SSL_CLIENT_VERIFY
# IPs/CIDRs de onde a Efí notifica, separados por vírgula. VAZIO = sem enforcement
# (default deliberado: lista ausente não pode derrubar o webhook). O IP avaliado
# é o último salto do X-Forwarded-For — ver shopman/shop/webhooks/efi.py.
# ⚠️ Recomendação atual: deixar vazio. As fontes oficiais da Efí discordam e a
# lista completa é de 2017 — levantamento e procedimento em
# docs/runbooks/release-secrets-runbook.md, seção "Allowlist de IP".
# EFI_WEBHOOK_IP_ALLOWLIST=
# Certificado mTLS — forneça UM dos três (precedência: PATH > PEM > BASE64).
# Em PaaS sem volume (DigitalOcean App Platform), use a variante inline:
# EFI_CERTIFICATE_PATH=       # caminho .pem no container
# EFI_CERTIFICATE_PEM=        # conteúdo PEM inline (multiline)
# EFI_CERTIFICATE_PEM_BASE64= # PEM codificado em base64 (single-line, recomendado p/ env)

# ── Stripe (card backend) ─────────────────────────────────────────────
# Staging/test keys must use pk_test_ / sk_test_. Live keys are blocked by
# smoke-gateways-sandbox outside production.
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=
# Só para o CARTÃO da loja online (manual = a loja cobra ao aceitar). O link de
# pagamento do balcão captura sozinho, sempre, independente desta env.
# STRIPE_CAPTURE_METHOD=manual

# ── Fiscal / Accounting (optional) ────────────────────────────────────
# Dotted path to a FiscalBackend class. Leave unset to disable NFC-e emission.
# SHOPMAN_FISCAL_ADAPTER=shopman.shop.adapters.fiscal_focusnfe.FocusNFeBackend
# Resolver(es) que decidem SE emitir a NFC-e (callable(order)->bool; vírgula = OR).
# Padrão do código: on_request_or_tax_id (emite se operador pediu OU cliente deu CPF).
# Exemplos + combinadores em shopman/shop/fiscal_resolvers.py. Redefina no go-live:
# SHOPMAN_FISCAL_EMISSION_RESOLVER=shopman.shop.fiscal_resolvers.on_request_or_tax_id
# Composição usada em staging/alpha (OR): pediu/CPF na nota, OU pagamento eletrônico
# (lê os TENDERS — venda mista com cartão emite), OU liquidação adiada
# (deferred_settlement: COD/conta na casa — a mercadoria sai antes do dinheiro, a nota vai junto).
# SHOPMAN_FISCAL_EMISSION_RESOLVER=shopman.shop.fiscal_resolvers.on_request_or_tax_id,shopman.shop.fiscal_resolvers.eletronic_payment,shopman.shop.fiscal_resolvers.deferred_settlement
# FOCUS_NFE_ENVIRONMENT=homologacao
# Token Focus NFe homolog/prod. Adapter uses HTTP Basic Auth with token as username and blank password.
# FOCUS_NFE_TOKEN=
# Optional override. When empty, Focus NFe uses Shop.document from the establishment profile.
# FOCUS_NFE_CNPJ_EMITENTE=
# FOCUS_NFE_NFCE_SERIE=
# FOCUS_NFE_NFCE_COMPLETA=1
# FOCUS_NFE_NFCE_LOCAL_DESTINO=1
# FOCUS_NFE_NFCE_PRESENCA_COMPRADOR=1
# FOCUS_NFE_NFCE_MODALIDADE_FRETE=9
# FOCUS_NFE_NATUREZA_OPERACAO=VENDA AO CONSUMIDOR
# FOCUS_NFE_NFCE_DEFAULT_CFOP=5102
# FOCUS_NFE_BASE_URL=        # leave empty; homologação resolves to Focus homolog URL
# FOCUS_NFE_TIMEOUT=30
# Leitor de NF-e/NFC-e para Compras > Receber. O adapter usa XML local em teste
# ou Distribuicao DF-e com certificado A1/PFX do destinatario.
# SHOPMAN_PURCHASE_INVOICE_READER=shopman.shop.adapters.purchase_invoice_nfe.read_invoice
# PURCHASE_NFE_ENVIRONMENT=homologacao
# PURCHASE_NFE_UF=41
# PURCHASE_NFE_RECIPIENT_DOCUMENT=
# PURCHASE_NFE_CERTIFICATE_PATH=
# PURCHASE_NFE_CERTIFICATE_PFX_BASE64=
# PURCHASE_NFE_CERTIFICATE_PASSWORD=
# PURCHASE_NFE_AUTO_MANIFEST_CIENCIA=false
# PURCHASE_NFE_XML_DIR=
# PURCHASE_NFE_FUZZY_MATCH_MIN_SCORE=0
# SHOPMAN_POS_DISCOUNT_APPROVAL_THRESHOLD_Q=0
# GUESTMAN_ORDER_HISTORY_BACKEND=shopman.guestman.adapters.orderman.OrdermanOrderHistoryBackend
# SHOPMAN_ACCOUNTING_BACKEND=nelson.adapters.accounting.InternalAccountingBackend

# ── ManyChat (WhatsApp notifications) ─────────────────────────────────
# WhatsApp is delivered via ManyChat flows — NOT Meta Cloud API directly.
# MANYCHAT_API_TOKEN=           # API token from ManyChat Settings → API
# MANYCHAT_OTP_FLOW_NS=         # Flow namespace for OTP template (e.g. content20250401_123456)
# MANYCHAT_WEBHOOK_SECRET=      # HMAC secret for webhook signature validation
# MANYCHAT_API_BASE=https://api.manychat.com/fb   # override only if needed
# MANYCHAT_API_TIMEOUT=15
# Inbound webhook (subscriber sync) é servido em /api/webhooks/manychat/webhook/
# (registrado quando MANYCHAT_WEBHOOK_SECRET está definido; rejeita sem HMAC válido).

# ── Doorman (passwordless auth / access links) ────────────────────────
# Required outside DEBUG for server-to-server access link creation.
# DOORMAN_ACCESS_LINK_API_KEY=

# ── SMS / OTP ─────────────────────────────────────────────────────────
# Código de login (OTP) vai por SMS — WhatsApp OTP não é viável via ManyChat (sem
# categoria Authentication). Provedor ativo = Comtele (BR). Trocar de provedor = trocar
# a classe em DOORMAN['DELIVERY_SENDERS']['sms'] (Twilio já implementado como fallback).
#
# Comtele (ativo) — API nova: header x-api-key. Chave no portal: Configurações → Chaves de API.
# COMTELE_API_KEY=
# COMTELE_ROUTE=                  # ID da rota de envio (GET api.comtele.com.br/routes lista);
#                                 # use a transacional/Premium p/ OTP, não a Marketing.
# COMTELE_TAG=shopman-otp         # rótulo de rastreio no painel (não é exibido ao cliente)
#
# Twilio (fallback) — só se trocar o sender p/ TwilioSMSSender:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=            # ex.: +15551234567 (ou use MESSAGING_SERVICE_SID)
# TWILIO_MESSAGING_SERVICE_SID=
# SHOPMAN_SMS_CODE_MESSAGE=      # opcional; default já inclui código + validade + aviso

# ── WhatsApp Bot (inbound messages — Meta Cloud API) ──────────────────
# WHATSAPP_VERIFY_TOKEN=        # Verify token for webhook setup
# WHATSAPP_STOREFRONT_URL=      # Base URL sent in access links (e.g. https://padaria.com)

# ── iFood (marketplace) ───────────────────────────────────────────────
# Integração DIRETA (API de desenvolvedor) — app no Portal do iFood, OAuth client_credentials.
# IFOOD_CLIENT_ID=             # client_id do app (Portal → Credenciais)
# IFOOD_CLIENT_SECRET=         # client_secret do app
# IFOOD_MERCHANT_ID=           # UUID da loja (GET /merchant/v1.0/merchants lista as acessíveis)
# IFOOD_API_BASE=https://merchant-api.ifood.com.br
# IFOOD_TIMEOUT=30
# IFOOD_WEBHOOK_TOKEN=         # legado/stub; readiness real exige OAuth acima para polling
# IFOOD_WEBHOOK_HMAC_SECRET=   # push opcional; default = IFOOD_CLIENT_SECRET
# IFOOD_CANCELLATION_CODE=     # código default só para cancelamento automático/fallback
# Catálogo legado (Bearer estático) — substituído pelo OAuth acima quando ligado:
# IFOOD_CATALOG_API_TOKEN=
# IFOOD_CATALOG_API_BASE=https://merchant-api.ifood.com.br

# ── Google Maps (UI de endereço no storefront) ────────────────────────
# GOOGLE_MAPS_API_KEY=

# ── Assist de IA (sugestão de texto no catálogo do Gestor) ────────────
# Sem chave o endpoint responde 503 e o Gestor mostra um aviso — o assist é
# conveniência, o operador segue escrevendo à mão.
# AI_ASSIST_API_KEY=           # chave da Anthropic (console.anthropic.com)
# AI_ASSIST_MODEL=claude-opus-5   # opcional: o default do código já é este
# AI_ASSIST_PROVIDER=anthropic

# ── Concierge de WhatsApp (pedido por conversa; ver docs/guides/whatsapp-concierge.md) ──
# SHOPMAN_CONCIERGE_ENABLED=false  # kill switch: false = o webhook responde "disabled" e o modelo não roda
# CONCIERGE_API_KEY=               # X-Api-Key que o External Request do ManyChat apresenta (default: DOORMAN_ACCESS_LINK_API_KEY)
# CONCIERGE_MODEL=claude-sonnet-5  # opcional: o modelo do concierge; claude-opus-5 é troca de env
# CONCIERGE_ALLOWED_SUBSCRIBERS=  # piloto fechado: ids do ManyChat e/ou telefones E.164 (com +), separados por vírgula; vazio = aberto

# ── Email (fallback de OTP/notificação; SMTP real fora de DEBUG) ───────
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=noreply@boulangerie.com.br
